{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:worker": "esbuild worker/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.mjs --tsconfig=tsconfig.json --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --log-level=warning",
    "worker:dev": "tsx --env-file=.env.local worker/server.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.7",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pdfkit": "0.20.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
