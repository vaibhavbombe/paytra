# Copy to .env.local and fill in. Never commit .env.local.
# Neon dashboard -> Connect -> pick your branch/database.

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/paytra?sslmode=verify-full&channel_binding=require"

# Direct connection (same host WITHOUT "-pooler"). Used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/paytra?sslmode=verify-full&channel_binding=require"

# ── App ──
# Exact origin the browser uses; POST/DELETE from any other origin are rejected (CSRF).
APP_ORIGIN="http://localhost:3000"

# ── Firebase web app (public identifiers, not secrets) ──
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Admin (server only) ──
FIREBASE_PROJECT_ID=""
# Path to the service-account JSON, kept OUTSIDE this repo. Not used on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS="C:\Users\Vaibhav\.secrets\paytra-firebase-adminsdk.json"

# ── Statement uploads (private Cloud Storage bucket; not a secret) ──
STATEMENTS_BUCKET="paytra-66fab-statements"
