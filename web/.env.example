# Copy to .env.local and fill in. Never commit .env.local.
# Neon dashboard -> Connect -> pick your branch/database.

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/paytra?sslmode=verify-full&channel_binding=require"

# Direct connection (same host WITHOUT "-pooler"). Used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/paytra?sslmode=verify-full&channel_binding=require"